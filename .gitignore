# general things to ignore
.DS_Store
build/
build_contrib/
dist/
.cache/
*.egg-info/
*.egg
*.py[cod]
__pycache__/
*.so
*~

# IDE
.vscode/
.idea/

# misc
checkpoints/
test_waves/
reconstructed/
.python-version
ruff.log
/configs/inuse/
runs/
/garbages/
/flagged/
/experimental/

# python virtual environments
.venv/
venv/
env/

# generated audio / outputs (keep locally, don't commit)
/output/
examples/target/

# never commit .wav files: model-generated audio (conversions, references) and
# the large training datasets under data/. NOTE: the example .wav files already
# committed stay tracked — git ignores .gitignore rules for tracked files.
# To intentionally add a NEW source .wav: git add -f <file>
*.wav

# generated archives (e.g. batch-conversion result zips)
*.zip

# local-only scripts / scratch
rt_benchmark.py
